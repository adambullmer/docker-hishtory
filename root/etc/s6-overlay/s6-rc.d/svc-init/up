#!/usr/bin/with-contenv bash
# ==============================================================================
# S6-Overlay Initialization Service (svc-init: oneshot)
# Handles secrets resolution, LinuxServer permissions, Web UI auth, and runtime env
# ==============================================================================

set -e

echo "[hishtory-init] Initializing self-hosted hiSHtory container..."

# ------------------------------------------------------------------------------
# Helper: Resolve environment variables or Docker secret files
# Priority: 1. <VAR>_FILE, 2. $<VAR>, 3. /run/secrets/
# ------------------------------------------------------------------------------
resolve_secret() {
    local var_name="$1"
    local default_val="$2"
    local file_var_name="${var_name}_FILE"
    local file_path="${!file_var_name}"
    local var_lower
    var_lower=$(echo "$var_name" | tr '[:upper:]' '[:lower:]')

    if [ -n "$file_path" ] && [ -f "$file_path" ]; then
        head -n 1 "$file_path" | tr -d '\r\n'
    elif [ -n "${!var_name}" ]; then
        echo "${!var_name}"
    elif [ -f "/run/secrets/${var_name}" ]; then
        head -n 1 "/run/secrets/${var_name}" | tr -d '\r\n'
    elif [ -f "/run/secrets/${var_lower}" ]; then
        head -n 1 "/run/secrets/${var_lower}" | tr -d '\r\n'
    else
        echo "$default_val"
    fi
}

# ------------------------------------------------------------------------------
# Resolve Configuration Parameters & Secrets
# ------------------------------------------------------------------------------
MODE=$(resolve_secret "MODE" "all")
PUID=$(resolve_secret "PUID" "1000")
PGID=$(resolve_secret "PGID" "1000")
PORT=$(resolve_secret "PORT" "8080")

HISHTORY_SECRET_KEY=$(resolve_secret "HISHTORY_SECRET_KEY" "")
HISHTORY_POSTGRES_DB=$(resolve_secret "HISHTORY_POSTGRES_DB" "")
HISHTORY_SQLITE_DB=$(resolve_secret "HISHTORY_SQLITE_DB" "/config/hishtory.db")

WEB_USER=$(resolve_secret "WEB_USER" "admin")
WEB_PASSWORD=$(resolve_secret "WEB_PASSWORD" "")
WEB_PASSWORD_HASH=$(resolve_secret "WEB_PASSWORD_HASH" "")
if [ -z "$WEB_PASSWORD_HASH" ]; then
    WEB_PASSWORD_HASH=$(resolve_secret "WEB_AUTH_HASH" "")
fi

THEME=$(resolve_secret "THEME" "")
if [ -z "$THEME" ]; then
    THEME=$(resolve_secret "WEB_THEME" "")
fi
if [ -z "$THEME" ]; then
    THEME=$(resolve_secret "HISHTORY_THEME" "")
fi
THEME=$(echo "$THEME" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')

# ------------------------------------------------------------------------------
# Directory Creation & LinuxServer Permissions
# ------------------------------------------------------------------------------
mkdir -p /config/nginx /config/client /config/data /run/nginx /run/hishtory

# ------------------------------------------------------------------------------
# Web UI Basic Authentication Setup (htpasswd)
# ------------------------------------------------------------------------------
HTPASSWD_FILE="/config/nginx/htpasswd"

if [ -n "$WEB_PASSWORD_HASH" ]; then
    echo "[hishtory-init] Using configured password hash for Web UI user: '${WEB_USER}'"
    echo "${WEB_USER}:${WEB_PASSWORD_HASH}" > "$HTPASSWD_FILE"
elif [ -n "$WEB_PASSWORD" ]; then
    echo "[hishtory-init] Generating bcrypt htpasswd for Web UI user: '${WEB_USER}'"
    htpasswd -b -B -c "$HTPASSWD_FILE" "$WEB_USER" "$WEB_PASSWORD"
elif [ ! -f "$HTPASSWD_FILE" ]; then
    # Generate a random secure password if none provided
    RANDOM_PASS=$(head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 16)
    echo "================================================================================"
    echo "[hishtory-init] [SECURITY NOTICE] No WEB_PASSWORD or WEB_PASSWORD_HASH configured."
    echo "[hishtory-init] Generated temporary Web UI credentials:"
    echo "[hishtory-init]   Username: ${WEB_USER}"
    echo "[hishtory-init]   Password: ${RANDOM_PASS}"
    echo "[hishtory-init] Please configure WEB_PASSWORD or WEB_PASSWORD_HASH in production!"
    echo "================================================================================"
    htpasswd -b -B -c "$HTPASSWD_FILE" "$WEB_USER" "$RANDOM_PASS"
fi
chmod 600 "$HTPASSWD_FILE"

# ------------------------------------------------------------------------------
# Web UI Theme Resolution & Dynamic Nginx Configuration
# Priority:
#   1. Conventional /config/theme.css if it exists
#   2. Built-in theme by name in /usr/share/hishtory/themes/${THEME}.css if set
#   3. Otherwise, theme injection disabled
# ------------------------------------------------------------------------------
CONVENTIONAL_THEME="/config/theme.css"
BUILTIN_THEMES_DIR="/usr/share/hishtory/themes"
THEME_CONF="/etc/nginx/conf.d/theme.conf"
mkdir -p /etc/nginx/conf.d

ACTIVE_THEME_FILE=""

if [ -f "$CONVENTIONAL_THEME" ]; then
    ACTIVE_THEME_FILE="$CONVENTIONAL_THEME"
    echo "[hishtory-init] Using custom theme from conventional location: ${CONVENTIONAL_THEME}"
    if [ -n "$THEME" ]; then
        echo "[hishtory-init] [NOTE] THEME='${THEME}' ignored because custom ${CONVENTIONAL_THEME} is present."
    fi
elif [ -n "$THEME" ]; then
    BUILTIN_SOURCE="${BUILTIN_THEMES_DIR}/${THEME}.css"
    if [ -f "$BUILTIN_SOURCE" ]; then
        ACTIVE_THEME_FILE="$BUILTIN_SOURCE"
        echo "[hishtory-init] Using built-in theme: ${THEME} (${BUILTIN_SOURCE})"
    else
        echo "[hishtory-init] [WARNING] Requested theme '${THEME}' not found in ${BUILTIN_THEMES_DIR}."
        echo "[hishtory-init] Available themes: $(ls -1 "$BUILTIN_THEMES_DIR" 2>/dev/null | sed 's/\.css$//' | tr '\n' ' ')"
    fi
fi

if [ -n "$ACTIVE_THEME_FILE" ]; then
    echo "[hishtory-init] Enabling Nginx theme injection pointing to ${ACTIVE_THEME_FILE}"
    cat <<EOF > "$THEME_CONF"
# Serves the active theme CSS file
location = /theme.css {
    alias ${ACTIVE_THEME_FILE};
    default_type text/css;
    add_header Content-Type text/css;
    add_header Cache-Control "no-cache, must-revalidate";
}

# Subrequest endpoint returning the theme link tag
location = /_theme_tag {
    internal;
    default_type text/html;
    return 200 '<link rel="stylesheet" type="text/css" href="/theme.css">\\n';
}
EOF
else
    echo "[hishtory-init] No theme configured. Theme injection disabled."
    cat <<'EOF' > "$THEME_CONF"
# Theme injection disabled (no active theme)
location = /_theme_tag {
    internal;
    return 204;
}
EOF
fi

# ------------------------------------------------------------------------------
# Single-User Client Initialization & Token Linking Info
# ------------------------------------------------------------------------------
export HOME="/config/client"
export HISHTORY_SERVER="http://127.0.0.1:8081"

if [ -n "$HISHTORY_SECRET_KEY" ]; then
    if [ ! -f "/config/client/.hishtory/config.json" ] && [ ! -d "/config/client/.hishtory" ]; then
        echo "[hishtory-init] HISHTORY_SECRET_KEY configured; client setup will initialize when Ingress server is ready."
    else
        echo "[hishtory-init] hishtory client configuration exists in /config/client."
    fi
else
    echo "[hishtory-init] [INFO] HISHTORY_SECRET_KEY not set. Web UI will idle; backend Ingress sync API is fully operational."
fi

# ------------------------------------------------------------------------------
# Export Runtime Environment for S6 Longrun Services
# ------------------------------------------------------------------------------
cat <<EOF > /run/hishtory/runtime.env
MODE=${MODE}
PORT=${PORT}
HISHTORY_SERVER_PORT=8081
HISHTORY_POSTGRES_DB=${HISHTORY_POSTGRES_DB}
HISHTORY_SQLITE_DB=${HISHTORY_SQLITE_DB}
HISHTORY_SECRET_KEY=${HISHTORY_SECRET_KEY}
HISHTORY_SERVER=${HISHTORY_SERVER}
HOME=/config/client
PUID=${PUID}
PGID=${PGID}
EOF

# Ensure appropriate permissions on persistent /config and /run directories
chown -R "${PUID}:${PGID}" /config /run/hishtory /run/nginx /var/lib/nginx /var/log/nginx

echo "[hishtory-init] Initialization complete. Mode: ${MODE}, Public Port: ${PORT}."
exit 0
