# ==============================================================================
# hiSHtory Container Environment Configuration
# Copy this file to .env and customize for your deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# User & Permission Mapping (LinuxServer Standard)
# ------------------------------------------------------------------------------
PUID=1000
PGID=1000
TZ=UTC

# ------------------------------------------------------------------------------
# Network & Port
# ------------------------------------------------------------------------------
# Public port mapped on the host
PORT=8080

# ------------------------------------------------------------------------------
# Operating Mode
# Options:
#   all     - Runs Ingress Server, Web Server, and Nginx reverse proxy (Default)
#   ingress - Runs Ingress Server and Nginx reverse proxy only (CLI sync backend)
#   web     - Runs Web UI Server and Nginx reverse proxy only (History Explorer)
# ------------------------------------------------------------------------------
MODE=all

# ------------------------------------------------------------------------------
# Single-User Token & Client Pairing
# ------------------------------------------------------------------------------
# Secret key used to encrypt/decrypt shell history and link the internal Web UI.
# Generate on client via `hishtory init` or supply your existing secret key string.
# Supports Docker secret file via HISHTORY_SECRET_KEY_FILE or /run/secrets/hishtory_secret_key
HISHTORY_SECRET_KEY=

# ------------------------------------------------------------------------------
# Web UI Dashboard Authentication
# ------------------------------------------------------------------------------
# Username for Web UI Basic Auth (default: admin)
WEB_USER=admin

# Plaintext Web UI Password (will be automatically hashed via bcrypt on startup)
# Supports Docker secret file via WEB_PASSWORD_FILE or /run/secrets/web_password
WEB_PASSWORD=

# (Optional) Pre-encrypted htpasswd hash string (e.g. bcrypt $2y$... or SHA512)
# If provided, plaintext WEB_PASSWORD is not required and will not be stored.
# Supports Docker secret file via WEB_PASSWORD_HASH_FILE
WEB_PASSWORD_HASH=

# ------------------------------------------------------------------------------
# Web UI Theme Configuration
# ------------------------------------------------------------------------------
# Built-in themes ported from shadcn/ui with automatic Light/Dark mode support:
#   lime, amber, blue, cyan, emerald, fuchsia, green, indigo, orange, pink,
#   purple, red, rose, sky, teal, violet, yellow, zinc, slate, stone, gray, neutral
#
# Leave blank for default unstyled Bootstrap appearance.
# To provide a custom theme, leave THEME blank and mount your CSS to /config/theme.css
# Supports Docker secret file via THEME_FILE or /run/secrets/theme
THEME=

# ------------------------------------------------------------------------------
# Database Backend Configuration
# ------------------------------------------------------------------------------
# SQLite database path (default: /config/hishtory.db)
HISHTORY_SQLITE_DB=/config/hishtory.db

# (Optional) PostgreSQL connection string (uncomment if using PostgreSQL)
# Supports Docker secret file via HISHTORY_POSTGRES_DB_FILE
# HISHTORY_POSTGRES_DB=postgresql://hishtory:password@postgres:5432/hishtory?sslmode=disable
